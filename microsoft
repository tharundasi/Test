/* 1. Element Selector: Applies to all <body> tags */
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f4f7f6;
  color: #333333;
  line-height: 1.6;
  margin: 0;
  padding: 20px;
}

/* 2. Element Selector: Applies to all <h1> tags */
h1 {
  color: #2c3e50;
  font-size: 2.5rem;
  border-bottom: 2px solid #3498db;
  padding-bottom: 10px;
}

/* 3. Class Selector: Applies to any element with class="card" */
.card {
  background: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 20px;
  max-width: 400px;
  margin: 20px auto;
}

/* 4. ID Selector: Applies strictly to one unique element with id="main-btn" */
#main-btn {
  background-color: #3498db;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.3s ease;
}

/* 5. Pseudo-class Selector: Styles the button when hovered over */
#main-btn:hover {
  background-color: #2980b9;
}

